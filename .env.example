# Copy to .env and adjust. docker compose reads this file automatically.

# Signing key for dashboard JWTs. Change this for anything but local dev.
JWT_SECRET=dev-only-change-me

# Origin allowed to call the API from a browser ("*" for local dev).
CORS_ALLOW_ORIGIN=*

# Number of concurrent delivery workers per worker container.
WORKER_COUNT=8

# Base URL the dashboard uses to reach the API from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Absolute deadline on a delivery's life. Circuit-breaker skips deliberately do
# not consume the retry budget, so this guarantees a delivery to a permanently
# dead endpoint eventually dead-letters instead of deferring forever.
DELIVERY_MAX_AGE=24h

# Lifts the SSRF guard on delivery so the bundled test receiver (on a private
# address) is reachable. Local development only. In production leave this unset:
# with it enabled, a tenant can register http://169.254.169.254/ as an endpoint
# and have HookRelay hand back the instance's cloud credentials.
ALLOW_PRIVATE_ENDPOINTS=true

# Override the retry backoff (comma-separated durations). Empty means the
# default 5s,30s,2m,10m,30m,2h,5h. Compress it for tests.
RETRY_SCHEDULE=

# --- Rate limits (0 disables) -------------------------------------------------
# Per-tenant ceiling on authenticated requests. Enforced per API replica, so the
# effective global limit is this times the replica count.
RATE_LIMIT_PER_TENANT=200
RATE_LIMIT_TENANT_BURST=400
# Per-address limit on /auth/login and /auth/register. Deliberately low: those
# routes are bcrypt-backed, so password guessing must not be cheap.
RATE_LIMIT_PER_IP=5
RATE_LIMIT_IP_BURST=10

# --- Metrics ------------------------------------------------------------------
# Prometheus endpoint, on its own port so it is never exposed through the public
# ingress. Empty disables it.
METRICS_ADDR=:9100
METRICS_SAMPLE_INTERVAL=15s

# --- Growth control (0 disables each sweep) -----------------------------------
# Acknowledged stream entries are not removed automatically; without trimming
# Redis fills up and starts refusing writes.
STREAM_MAX_LEN=1000000
STREAM_TRIM_INTERVAL=10m
# delivery_attempts gains a row per HTTP attempt forever. Only attempts of
# already-settled deliveries are pruned, so nothing still retrying loses history.
ATTEMPT_RETENTION=720h
RETENTION_INTERVAL=6h
